# File Server Basic Configuration

# API认证令牌
AUTH_TOKEN=test

# 文件存储路径
FILE_STORAGE_PATH=storage

# 文件大小限制 (MB)
MAX_FILE_SIZE_MB=5000

# 分片上传配置 (MB)
UPLOAD_CHUNK_SIZE_MB=4
DOWNLOAD_CHUNK_SIZE_MB=4

# 服务器配置
VITE_FILE_SERVER_HOST=0.0.0.0
VITE_FILE_SERVER_PORT=8000

# API端点
# VITE_API_ENDPOINT=


# Pi AI Runtime Configuration
PI_PROVIDER_BASE_URL=https://api.openai.com/v1
PI_PROVIDER_API_KEY=your-api-key-here
PI_DEFAULT_MODEL=gpt-5-nano
PI_TEMPERATURE=0.6
